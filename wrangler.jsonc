{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard, which Workers
  // Builds checks before every deploy.
  "name": "budigunawan",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Previews are served from workers.dev, so keep that hostname enabled even
  // though production is on the custom domain.
  "workers_dev": true,
}
