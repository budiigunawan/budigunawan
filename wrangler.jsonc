{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard, which Workers
  // Builds checks before every deploy.
  "name": "budigunawan",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Previews are served from workers.dev, so keep that hostname enabled. The
  // custom domain is added at launch, see docs/deployment.md.
  "workers_dev": true,
  // `wrangler preview` refuses to run without a previews block. It can stay
  // empty here: assets and compatibility settings belong at the top level.
  "previews": {}
}
