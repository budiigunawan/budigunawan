# Copy to .env and fill in for local development. Never commit real secrets.

# Production and local Postgres connection string.
DATABASE_URL=postgresql://user:password@host/dbname

# Preview deployments read this instead, so they never touch production.
# PREVIEW_DATABASE_URL=postgresql://user:password@preview-host/preview-dbname

# Long random string; required. Used to hash client addresses for rate limiting.
CONTACT_CLIENT_KEY_SECRET=replace-with-a-long-random-string

# Optional overrides.
# CONTACT_ALLOWED_ORIGINS=https://budigunawan-git-branch.vercel.app
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MINUTES=60

# Notification email through Resend. Without these, messages are stored but
# never emailed, and the gap is logged.
# RESEND_API_KEY=re_...
# CONTACT_EMAIL_FROM="Contact <contact@budigunawan.com>"
# CONTACT_EMAIL_TO=budiindra.g@gmail.com
