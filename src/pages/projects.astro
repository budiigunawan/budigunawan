---
import ExternalLink from '../components/ExternalLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../lib/content';

const { site, projects, projectLinkTarget } = await getContent();

const monthYear = new Intl.DateTimeFormat('en', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

const monthValue = (date: Date) => date.toISOString().slice(0, 7);

/** The title link stretches over its card, so the whole card is clickable. */
const cardLinkClass =
  'inline-flex items-baseline gap-1 no-underline transition-colors duration-(--motion-fast) hover:text-accent after:absolute after:inset-0 after:content-[\'\']';
---

<BaseLayout
  title={`Projects — ${site.name}`}
  description={`Projects built by ${site.name}.`}
  section="projects"
  site={site}
>
  <header class="max-w-2xl">
    <p class="eyebrow">Projects</p>
    <h1 class="mt-4 text-3xl font-normal tracking-[-0.01em] sm:text-4xl">Projects</h1>
    <p class="mt-6 max-w-prose text-lg text-muted">
      A selection of work, newest first. Follow a card to its Case Study, live site or
      repository.
    </p>
  </header>

  {
    projects.length > 0 && (
      <ul class="mt-14 grid gap-5 sm:grid-cols-2" aria-label="Projects">
        {projects.map((project) => {
          const target = projectLinkTarget(project);
          const stackLabel = `Stack for ${project.data.title}`;

          return (
            <li class="flex">
              <article class="relative flex w-full flex-col rounded-lg border border-line bg-surface p-6 transition-colors duration-(--motion-fast) hover:border-line-strong">
                <p class="text-sm text-muted">
                  <time datetime={monthValue(project.data.date)}>
                    {monthYear.format(project.data.date)}
                  </time>
                </p>
                <h2 class="mt-3 text-xl font-normal tracking-[-0.01em]">
                  {target.external ? (
                    <ExternalLink href={target.href} class={cardLinkClass}>
                      {project.data.title}
                    </ExternalLink>
                  ) : (
                    <a href={target.href} class={cardLinkClass}>
                      {project.data.title}
                    </a>
                  )}
                </h2>
                <p class="mt-3 text-muted">{project.data.summary}</p>
                <ul
                  class="mt-auto flex flex-wrap gap-x-2 gap-y-1 pt-6 text-xs"
                  aria-label={stackLabel}
                >
                  {project.data.stack.map((technology) => (
                    <li class="rounded-pill border border-line px-2.5 py-0.5 text-muted">
                      {technology}
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          );
        })}
      </ul>
    )
  }
</BaseLayout>
