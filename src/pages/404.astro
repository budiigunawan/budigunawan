---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="shell py-20 sm:py-28">
    <div class="max-w-[46rem]">
      <p class="eyebrow">404</p>

      <h1 class="mt-5 font-display text-[clamp(2.25rem,7vw,4rem)] leading-[1.05] font-semibold tracking-tight text-balance">
        This page doesn't exist.
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-ink-muted text-pretty">
        The address may be mistyped, or the page may have moved. The home page is the way back in.
      </p>

      <p class="mt-10">
        <a class="button button-primary" href="/">Back to the home page</a>
      </p>
    </div>
  </section>
</BaseLayout>
