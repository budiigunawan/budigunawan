---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../lib/content';

const { site } = await getContent();
---

<BaseLayout
  title={`${site.name} — ${site.role}`}
  description={site.pitch}
  section="home"
  site={site}
>
  <section aria-labelledby="hero-heading" class="max-w-3xl">
    <p class="eyebrow animate-rise">{site.role}</p>
    <h1
      id="hero-heading"
      class="animate-rise mt-5 text-display font-normal tracking-[-0.02em] [animation-delay:80ms]"
    >
      {site.name}
    </h1>
    <p class="animate-rise mt-7 max-w-xl text-lg text-muted [animation-delay:160ms]">
      {site.pitch}
    </p>
    <div
      class="animate-rise mt-10 flex flex-wrap items-center gap-x-7 gap-y-4 [animation-delay:240ms]"
    >
      <a class="cta-primary" href="/projects">
        View projects
        <svg
          aria-hidden="true"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a class="cta-secondary" href="/cv">Download CV</a>
      <a class="cta-secondary" href={`mailto:${site.email}`}>Get in touch</a>
    </div>
  </section>
</BaseLayout>
