---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../lib/content';

const { site } = await getContent();
---

<BaseLayout
  title={`${site.name} — ${site.role}`}
  description={site.pitch}
  section="home"
  site={site}
>
  <section aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="text-4xl font-semibold tracking-tight sm:text-5xl">
      {site.name}
    </h1>
    <p class="mt-4 text-xl text-muted">{site.role}</p>
    <p class="mt-6 max-w-prose text-lg leading-relaxed">{site.pitch}</p>
  </section>
</BaseLayout>
