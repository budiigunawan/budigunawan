---
import { render } from 'astro:content';

import ProjectBulletSection from '../../components/ProjectBulletSection.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import StackList from '../../components/StackList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectWorkEntry, getProjects, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, tags, demoUrl, repoUrl, cover, built, impact } = project.data;

const workEntry = await getProjectWorkEntry(project);
const { Content } = await render(project);

const links = [
  demoUrl && { label: 'Visit the site', href: demoUrl },
  repoUrl && { label: 'View the source', href: repoUrl },
].filter((link): link is { label: string; href: string } => Boolean(link));
---

<BaseLayout title={title} description={summary}>
  <section class="shell py-16 sm:py-24">
    <article class="max-w-[46rem]">
      <a class="link text-sm" href="/projects"><span aria-hidden="true">←</span> All projects</a>

      <div class="mt-6">
        <ProjectMeta project={project} />
      </div>

      <h1 class="mt-4 font-display text-[clamp(2.25rem,7vw,4rem)] leading-[1.05] font-semibold tracking-tight text-balance">
        {title}
      </h1>

      <p class="mt-5 text-lg leading-relaxed text-ink-muted text-pretty">{summary}</p>

      {
        workEntry && (
          <p class="mt-4 text-sm leading-relaxed text-ink-muted">
            Built at{' '}
            <a class="link" href={`/work#${workEntry.id}`}>
              {workEntry.data.company}
            </a>{' '}
            as {workEntry.data.role}.
          </p>
        )
      }

      {
        tags.length > 0 && (
          <div class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-2">
            <span class="section-label">Topics</span>
            <ul class="flex flex-wrap items-center gap-x-2 gap-y-1">
              {tags.map((tag, index) => (
                <li class="flex items-center gap-2 text-xs text-ink-muted">
                  {index > 0 && <span aria-hidden="true">·</span>}
                  {tag}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        cover && (
          <img
            src={cover.src}
            alt={cover.alt}
            width={cover.width}
            height={cover.height}
            decoding="async"
            class="mt-8 h-auto w-full rounded-lg border border-rule"
          />
        )
      }

      <div class="mt-12 space-y-10 border-t border-rule pt-10">
        <section aria-labelledby="stack-heading">
          <h2 id="stack-heading" class="section-label">Stack</h2>
          <StackList stack={project.data.stack} class="mt-3" />
        </section>

        <ProjectBulletSection id="built-heading" title="What was built" items={built} />
        <ProjectBulletSection id="impact-heading" title="Impact" items={impact} />

        {
          links.length > 0 && (
            <section aria-labelledby="links-heading">
              <h2 id="links-heading" class="section-label">Links</h2>
              <ul class="mt-3 flex flex-wrap gap-3">
                {links.map((link) => (
                  <li>
                    <a class="button" href={link.href} rel="noopener" target="_blank">
                      {link.label}
                      <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          project.body?.trim() && (
            <div class="entry-body border-t border-rule pt-10">
              <Content />
            </div>
          )
        }
      </div>
    </article>
  </section>
</BaseLayout>
