---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout
  title="Blog"
  description="Notes from Budi Indra Gunawan on building software, newest first, with the year-in-review retrospectives gathered separately."
>
  <section class="shell py-16 sm:py-24">
    <div class="max-w-[46rem]">
      <p class="eyebrow">Writing</p>

      <h1 class="mt-5 font-display text-[clamp(2.25rem,7vw,4rem)] leading-[1.05] font-semibold tracking-tight text-balance">
        Blog
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-ink-muted text-pretty">
        Notes on building software, newest first. Yearly retrospectives live in <a class="link" href="/retro">Retro</a>.
      </p>
    </div>

    <div class="mt-12 max-w-[52rem] border-t border-rule">
      {
        posts.length > 0 ? (
          <PostList posts={posts} />
        ) : (
          <p class="pt-8 text-ink-muted">Nothing is published yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
