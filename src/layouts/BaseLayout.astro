---
import '../styles/global.css';
import ExternalLink from '../components/ExternalLink.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
import type { SiteProfile } from '../data/site';
import { analyticsToken } from '../data/analytics';
import { THEME_CHANGE_EVENT, THEME_STORAGE_KEY } from '../lib/theme';

export interface Props {
  title: string;
  description: string;
  section?: 'home' | 'about' | 'projects';
  site: SiteProfile;
}

const { title, description, section, site } = Astro.props;

const analyticsHost = new URL(site.siteUrl).hostname;

const navigation = [
  { href: '/', label: 'Home', section: 'home' },
  { href: '/about', label: 'About', section: 'about' },
  { href: '/projects', label: 'Projects', section: 'projects' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script
      is:inline
      define:vars={{ themeStorageKey: THEME_STORAGE_KEY, themeChangeEvent: THEME_CHANGE_EVENT }}
    >
      (function () {
        var media = window.matchMedia('(prefers-color-scheme: dark)');

        function storedChoice() {
          try {
            return window.localStorage.getItem(themeStorageKey);
          } catch (error) {
            return null;
          }
        }

        function apply(theme) {
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        }

        var stored = storedChoice();
        apply(stored === 'light' || stored === 'dark' ? stored : media.matches ? 'dark' : 'light');

        media.addEventListener('change', function (event) {
          if (window.themeChoiceMade || storedChoice() !== null) return;
          var theme = event.matches ? 'dark' : 'light';
          apply(theme);
          document.dispatchEvent(
            new CustomEvent(themeChangeEvent, { detail: { theme: theme } }),
          );
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script src="../scripts/analytics.ts"></script>
  </head>
  <body
    class="flex min-h-dvh flex-col"
    data-analytics-token={analyticsToken}
    data-analytics-host={analyticsHost}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-sm focus:bg-canvas focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-ink focus:shadow-lg"
    >
      Skip to main content
    </a>

    <header class="border-b border-line">
      <div class="container-page flex flex-wrap items-center gap-x-6 gap-y-3 py-5">
        <a href="/" class="font-serif text-lg font-medium tracking-tight">{site.name}</a>

        <nav aria-label="Main" class="order-3 w-full sm:order-none sm:ml-auto sm:w-auto">
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-1 text-sm">
            {
              navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={section === item.section ? 'page' : undefined}
                    class="text-muted transition-colors duration-(--motion-fast) hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[10px]"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="ml-auto sm:ml-0">
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="container-page flex-1 py-14 sm:py-20">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="container-page flex flex-wrap items-center justify-between gap-x-8 gap-y-4 py-10 text-sm"
      >
        <p class="text-muted">&copy; {new Date().getFullYear()} {site.name}</p>
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><ExternalLink href={site.githubUrl} rel="me">GitHub</ExternalLink></li>
          <li><ExternalLink href={site.linkedinUrl} rel="me">LinkedIn</ExternalLink></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
