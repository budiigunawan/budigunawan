---
interface Props {
  id: string;
  title: string;
  items: string[];
}

const { id, title, items } = Astro.props;
---

<section aria-labelledby={id}>
  <h2 id={id} class="section-label">{title}</h2>
  <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-muted">
    {items.map((item) => <li class="text-pretty">{item}</li>)}
  </ul>
</section>
