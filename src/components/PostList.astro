---
import { formatFullDate, dayDatetime } from '../lib/dates';
import type { Post } from '../lib/content';
import PostTags from './PostTags.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ol class="border-t border-rule">
  {
    posts.map((post) => (
      <li class="border-b border-rule py-8">
        <article>
          <time class="section-label" datetime={dayDatetime(post.data.date)}>
            {formatFullDate(post.data.date)}
          </time>

          <h2 class="mt-2 font-display text-2xl leading-tight font-semibold tracking-tight text-ink">
            <a class="transition-colors hover:text-accent" href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
          </h2>

          <p class="mt-2 text-pretty text-ink-muted">{post.data.summary}</p>

          <PostTags tags={post.data.tags} class="mt-3" />
        </article>
      </li>
    ))
  }
</ol>
