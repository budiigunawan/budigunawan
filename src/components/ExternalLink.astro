---
export interface Props {
  href: string;
  rel?: string;
  class?: string;
}

const { href, rel, class: className } = Astro.props;
---

<a href={href} rel={rel} class:list={['link', className]}>
  <slot />
  <span class="external-link__mark" aria-hidden="true">↗</span>
  <span class="sr-only"> (external)</span>
</a>
