---
import type { Project } from '../lib/content';
import ProjectMeta from './ProjectMeta.astro';
import StackList from './StackList.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, stack, cover } = project.data;
const href = `/projects/${project.id}`;
---

<article class="border-b border-rule py-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:gap-8">
    {
      cover && (
        <img
          src={cover.src}
          alt={cover.alt}
          width={cover.width}
          height={cover.height}
          loading="lazy"
          decoding="async"
          class="h-auto w-full rounded-lg border border-rule sm:order-last sm:w-64 sm:shrink-0"
        />
      )
    }

    <div class="min-w-0 flex-1">
      <ProjectMeta project={project} />

      <h2 class="mt-3 font-display text-2xl leading-tight font-semibold tracking-tight text-ink">
        <a class="transition-colors hover:text-accent" href={href}>{title}</a>
      </h2>

      <p class="mt-2 text-pretty text-ink-muted">{summary}</p>

      <p class="section-label mt-4">Stack</p>
      <StackList stack={stack} class="mt-2" />
    </div>
  </div>
</article>
