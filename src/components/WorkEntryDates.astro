---
import { formatMonthYear, monthDatetime } from '../lib/dates';

interface Props {
  start: Date;
  end?: Date;
}

const { start, end } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-2 gap-y-2 sm:block sm:pt-1">
  <p class="font-mono text-xs tracking-wide text-ink-muted">
    <span class="sr-only">From </span>
    <time datetime={monthDatetime(start)}>{formatMonthYear(start)}</time>
    <span aria-hidden="true"> – </span>
    <span class="sr-only"> to </span>
    {end ? <time datetime={monthDatetime(end)}>{formatMonthYear(end)}</time> : <span>Present</span>}
  </p>

  {
    end ? null : (
      <p class="inline-flex items-center rounded-full border border-accent px-2 py-0.5 font-sans text-[0.6875rem] font-medium tracking-[0.08em] text-accent uppercase sm:mt-3">
        Current
      </p>
    )
  }
</div>
