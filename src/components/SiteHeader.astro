---
import { site } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(`${href}/`));
---

<header class="border-b border-rule print:hidden">
  <div class="shell flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-3 sm:py-4">
    <a href="/" class="inline-flex min-h-11 items-center font-display text-lg font-semibold tracking-tight text-ink">
      {site.name}
    </a>

    <nav aria-label="Primary" class="order-3 w-full sm:order-2 sm:ml-auto sm:w-auto">
      <ul class="flex flex-wrap items-center gap-0.5 sm:gap-1 sm:justify-end">
        {
          site.nav.map((item) => (
            <li>
              <a
                class="nav-link px-1 sm:px-2"
                href={item.href}
                target={item.newTab ? '_blank' : undefined}
                rel={item.newTab ? 'noopener' : undefined}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
                {item.newTab && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="order-2 sm:order-3">
      <ThemeToggle />
    </div>
  </div>
</header>
