---
import { site } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(`${href}/`));
---

<header class="border-b border-rule print:hidden">
  <div class="shell flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-3 sm:py-4">
    <a href="/" class="inline-flex min-h-11 items-center font-display text-lg font-semibold tracking-tight text-ink">
      {site.name}
    </a>

    <div class="flex items-center gap-3 sm:gap-5">
      <nav aria-label="Primary">
        <ul class="flex items-center gap-1">
          {
            site.nav.map((item) => (
              <li>
                <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ThemeToggle />
    </div>
  </div>
</header>
