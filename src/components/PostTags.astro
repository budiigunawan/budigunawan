---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['flex flex-wrap items-center gap-x-2 gap-y-1', className]}>
      {tags.map((tag, index) => (
        <li class="flex items-center gap-2 text-xs text-ink-muted">
          {index > 0 && <span aria-hidden="true">·</span>}
          {tag}
        </li>
      ))}
    </ul>
  )
}
